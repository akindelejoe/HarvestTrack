# =====================================================================
# HarvestTrack — Docker Compose configuration
#   cp .env.example .env    and replace every "change-me" value.
#   Never commit .env — it is git-ignored.
#
# Running WITHOUT Docker? Use server/.env.example instead (it points
# DATABASE_URL at localhost).
# =====================================================================

# --- PostgreSQL container ---
POSTGRES_DB=harvesttrack
POSTGRES_USER=harvest
# URL-safe characters only (letters, digits, - _ .) — it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Host port for connecting GUI tools to the container's database (internal port stays 5432)
POSTGRES_HOST_PORT=5434

# Compose builds DATABASE_URL from the values above using the service name "postgres":
#   postgresql://harvest:<password>@postgres:5432/harvesttrack
# Only set it yourself when running the API outside Docker:
# DATABASE_URL=postgresql://harvest:change-me@localhost:5434/harvesttrack

# --- API ---
# Long random string: openssl rand -hex 32
JWT_SECRET=change-me
SESSION_TTL_HOURS=72
# Create the demo account on first start (only when the database has no users)
SEED_DEMO_DATA=true
# Set true when serving HarvestTrack over HTTPS
COOKIE_SECURE=false

# --- Web ---
FRONTEND_PORT=8080

# --- Weather ---
# open-meteo (default, no key) | openweathermap (needs WEATHER_API_KEY) | mock (offline)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
ALERT_SCAN_INTERVAL_MINUTES=180

# --- SMS (optional — leave blank to log messages instead of sending) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
