# --- Core ---
NODE_ENV=development
PORT=4100
CLIENT_ORIGIN=http://localhost:5180

# PostgreSQL connection string (npm run db:local starts one on port 5433)
DATABASE_URL="postgresql://harvest:harvest@localhost:5433/harvesttrack"

# Long random string used to sign session tokens (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72

# --- Weather ---
# open-meteo (default, no key) | openweathermap (needs WEATHER_API_KEY) | mock (offline demo)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CACHE_MINUTES=30

# Background hazard scan interval (0 disables the scheduler)
ALERT_SCAN_INTERVAL_MINUTES=180

# --- SMS (optional). Leave blank to log messages to the console instead. ---
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
